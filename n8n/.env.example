# Copy to n8n/.env (gitignored). Same value as `npx convex env set N8N_SIGNING_SECRET ...`.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
N8N_SIGNING_SECRET=
# Optional override; default reaches a Convex dev backend on the host.
# LENDLOOP_CONVEX_SITE_URL=https://<deployment>.convex.site

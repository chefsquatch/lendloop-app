# ---- Next.js (.env.local) ----
# Written by `npx convex dev`
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
# Clerk dashboard > API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ---- Convex deployment env (set with `npx convex env set NAME value`, NOT in this file) ----
# CLERK_JWT_ISSUER_DOMAIN   Issuer URL of the Clerk "convex" JWT template
# ADMIN_EMAILS              Comma-separated emails that get the admin role on sign-in
# N8N_LOAN_EVENT_WEBHOOK_URL  n8n Webhook node URL for loan notifications (workflow 1)
# N8N_SIGNING_SECRET          Shared HMAC secret: signs Convex->n8n webhooks and verifies n8n->Convex calls

# ---- n8n container env: n8n/.env (see n8n/.env.example and n8n/README.md) ----
